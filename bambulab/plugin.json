{
  "plugin_key": "bambulab",
  "name": "Bambu Lab",
  "driver_key": "bambulab",
  "plugin_type": "driver",
  "version": "2.3.2",
  "description": "Bambu Lab printer driver via bambulabs_api. Supports AMS, RFID and automatic filament matching.",
  "author": "FilaMan",
  "homepage": "https://www.filaman.app",
  "dependencies": ["bambulabs_api>=2.6.0"],
  "config_schema": {
    "type": "object",
    "properties": {
      "printer_model": {
        "type": "string",
        "title": "Printer Model",
        "description": "Select your Bambu Lab printer model. Determines AMS data structure handling.",
        "enum": ["P1S", "P1P", "X1C", "X1E", "A1", "A1_MINI", "H2C", "H2D", "H2S", "P2S"],
        "enumNames": ["P1S", "P1P", "X1 Carbon", "X1E", "A1", "A1 Mini", "H2C", "H2D", "H2S", "P2S"],
        "default": "P1S"
      },
      "host": {
        "type": "string",
        "title": "IP/Hostname",
        "description": "IP address or hostname of the Bambu printer"
      },
      "serial": {
        "type": "string",
        "title": "Serial Number",
        "description": "Printer serial number"
      },
      "access_code": {
        "type": "string",
        "title": "Access Code",
        "description": "Printer access code"
      },
      "reconnect_interval_minutes": {
        "type": "integer",
        "title": "Reconnect Interval (Minuten)",
        "description": "Interval in minutes between reconnection attempts on connection loss",
        "default": 5,
        "minimum": 1,
        "maximum": 60
      }
    },
    "required": ["printer_model", "host", "serial", "access_code"]
  },
  "capabilities": {
    "has_slots": true,
    "has_rfid": true,
    "has_ams": true,
    "supports_auto_match": true
  },
  "printer_params": {
    "target_types": ["filament_printer_param", "spool_printer_param"],
    "fields": [
      {"key": "bambu_idx", "label": "Bambu Material Index", "field_type": "dropdown", "options_file": "bambu_filaments.json"},
      {"key": "bambu_tray_idx", "label": "Tray Info Index", "field_type": "text"},
      {"key": "bambu_setting_id", "label": "Setting ID", "field_type": "text"},
      {"key": "bambu_cali_idx", "label": "Calibration Index", "field_type": "text"},
      {"key": "bambu_k_value", "label": "K Value", "field_type": "number"},
      {"key": "bambu_flow_ratio", "label": "Flow Ratio", "field_type": "number"},
      {"key": "bambu_bed_temp", "label": "Bed Temperature", "field_type": "number"},
      {"key": "bambu_nozzle_temp_min", "label": "Nozzle Temp Min", "field_type": "number"},
      {"key": "bambu_nozzle_temp_max", "label": "Nozzle Temp Max", "field_type": "number"},
      {"key": "bambu_max_volumetric_speed", "label": "Max Volumetric Speed", "field_type": "number"}
    ],
    "migration": {
      "legacy_renames": {
        "bambu_cali_id": "bambu_cali_idx",
        "bambu_k": "bambu_k_value",
        "bambu_max_volspeed": "bambu_max_volumetric_speed",
        "bambu_nozzle_temp": "bambu_nozzle_temp_min"
      }
    }
  }
}